{
  "date": "2026-08-03",
  "keywords": [
    {
      "id": 1,
      "term": "OKR",
      "category": "管理",
      "definition": "<strong>含义：</strong>目标与关键结果（Objectives & Key Results），一种目标管理工具，强调“定性目标+量化结果”，聚焦最重要的优先级。",
      "example": "<strong>举例：</strong>目标“成为团队技术骨干”，关键结果“完成3项核心课题/获2次内部优秀评价/输出1份技术白皮书”，可追踪可评估。"
    },
    {
      "id": 2,
      "term": "碳封存",
      "category": "环境",
      "definition": "<strong>含义：</strong>将CO₂从大气或排放源捕集后，长期储存于地质层（咸水层、废弃油气田）或矿化为固体碳酸盐的技术，是CCUS的最终处置环节。",
      "example": "<strong>举例：</strong>挪威Northern Lights项目将工业排放的CO₂通过船运和管道注入北海海底咸水层，设计封存量每年达数百万吨，是欧洲最大的CCUS商业项目之一。"
    },
    {
      "id": 3,
      "term": "现金流",
      "category": "经济",
      "definition": "<strong>含义：</strong>企业实际收到和支出的现金流量，比利润更真实地反映经营健康度；“利润≠钱”，没有现金流就无法生存。",
      "example": "<strong>举例：</strong>一家工程公司账面盈利500万，但应收款压了3000万未收回，资金链断裂而倒闭；健康的现金流才是企业真正的血液。"
    },
    {
      "id": 4,
      "term": "注意力管理",
      "category": "成长",
      "definition": "<strong>含义：</strong>主动管理和保护自己的注意力资源，防止被低价值信息消耗，优先将注意力投入到高价值活动上的能力。",
      "example": "<strong>举例：</strong>打开手机“意外刷了20分钟短视频”是注意力被盗；每天设定“无手机早晨1小时”可以保留最佳状态用于最重要的思考，是注意力管理的实践。"
    },
    {
      "id": 5,
      "term": "技术扩散",
      "category": "经济",
      "definition": "<strong>含义：</strong>新技术从发明到被广泛采用的过程，通常遵循S形曲线：创新者→早期采用者→早期大众→晚期大众→落后者，扩散速度受成本、复杂度和兼容性影响。",
      "example": "<strong>举例：</strong>智能手机在中国从2009年的3%渗透率到2019年的90%，历时10年完成S曲线；氢能汽车目前处于早期采用者阶段（渗透率<0.1%），看清所处位置才能制定正确策略。"
    }
  ]
}