    {
      "id": 1,
      "topic": "深海矿产资源",
      "category": "材料",
      "number": "约750亿",
      "unit": "吨（多金属结核，太平洋）",
      "context": "太平洋底部分布着约750亿吨多金属结核，含锰、镍、铜、钴等关键金属；深度约4000-6000m，开采技术和环境影响尚未解决，是“未来的矿山”。",
      "insight": "深海结核中的钴储量是陆地探明储量的数倍；钴是锂离子电池正极关键材料；深海采矿若商业化，将从根本上改变电池材料供应格局——但生态代价尚不可知。"
    },
    {
      "id": 2,
      "topic": "国际专利申请数量",
      "category": "经济",
      "number": "约27",
      "unit": "万件/年（PCT，2023年）",
      "context": "2023年全球PCT专利申请约27万件：中国约7万件（第一），美国约5.9万件，日本约4万件；中国首次超越美国成为全球最大专利申请国（2019年首次登顶）。",
      "insight": "7万件专利≈中国每年在氢能、AI、新能源等领域构建约7万道“技术护城河”；但专利数量不等于质量——高被引“核心专利”的比例，才是真正技术实力的衡量尺度。"
    },
    {
      "id": 3,
      "topic": "全球电力储能装机",
      "category": "能源",
      "number": "约300",
      "unit": "GW（2024年底）",
      "context": "2020年全球电化学储能约17GW；2024年底约300GW，4年增长约18倍；中国占约40%（主要是磷酸铁锂电池）；主要用于电网调峰和可再生能源平滑。",
      "insight": "300GW储能相当于300座核电机组的装机容量，但充放电持续时间仅2-4小时，并非等量替代。储能的价值在于调节频率和峰谷，而非简单的“能量仓库”。"
    }
  ]
