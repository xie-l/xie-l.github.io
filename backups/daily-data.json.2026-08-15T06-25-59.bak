  "data_items": [
    {
      "id": 1,
      "topic": "全球城镇化率",
      "category": "社会",
      "number": "约57%",
      "unit": "（2024年，城市人口占比）",
      "context": "1800年全球城镇化率约3%；1950年约30%；2024年约57%；预计2050年超70%。中国城镇化率从1978年的18%到2024年的66%，是人类史上规模最大的城镇化进程。",
      "insight": "城镇化每提高1%，约1300万中国人从农村迁入城市——他们带来的建筑、交通、能源需求增量，相当于每年“新建”一个中等规模国家的基础设施。城镇化是理解中国能源需求的第一条逻辑主线。"
    },
    {
      "id": 2,
      "topic": "全球淡水资源分布",
      "category": "生活",
      "number": "约2.5%",
      "unit": "（地球水体中淡水占比）",
      "context": "地球总水量约13.6亿立方公里；淡水约2.5%（约3400万立方公里），但97.5%锁在极地冰川和地下深层；可直接利用的淡水不足0.01%，主要在湖泊和河流中。",
      "insight": "可利用淡水仅0.01%×13.6亿=约13.6万立方公里；全球用水约4万立方公里/年，理论上够用——但分布极不均匀：巴西一国拥有全球淡水的约12%，而中东、北非人均淡水不足300m³/年。"
    },
    {
      "id": 3,
      "topic": "中国水泥年产量",
      "category": "工业",
      "number": "约21",
      "unit": "亿吨/年",
      "context": "全球水泥产量约45亿吨，中国占约47%；水泥生产过程（石灰石高温分解）是仅次于电力和钢铁的第三大CO₂排放源，占全球约8%。",
      "insight": "每生产1吨水泥排放约0.8吨CO₂；中国21亿吨水泥×0.8=约17亿吨CO₂，占全国总排放的约17%——“绿色水泥”（掺加矿渣、减少熟料比例）是建筑业脱碳的关键路径。"
    }
  ]
