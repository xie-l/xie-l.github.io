    {
      "id": 1,
      "topic": "中国可再生能源占比",
      "category": "气候",
      "number": "约35%",
      "unit": "（发电量占比，2024）",
      "context": "2015年约25%；2020年约29%；2024年约35%（风光水核合计）；目标2030年达到45%以上，2060年超过80%。",
      "insight": "35%的可再生能源意味着：你插上充电宝充的每3度电里，就有约1度来自风光水，另外约2度来自煤炭。“我用的是绿电”——距离真正实现还有路要走。"
    },
    {
      "id": 2,
      "topic": "铂族金属价格",
      "category": "材料",
      "number": "约940",
      "unit": "美元/盎司（铂，2024）",
      "context": "铂（Pt）约940美元/盎司（约30美元/g）；铱（Ir）约5000美元/盎司（约160美元/g），是PEM阳极催化剂；钌（Ru）约600美元/盎司。",
      "insight": "PEM电解槽阳极Ir用量约0.5mg/cm²，一个1m²电极用量约500mg=0.5g≈80美元的Ir成本；Ir催化剂占整个PEM电解槽成本约5-10%——降低Ir用量是降本的重要方向。"
    },
    {
      "id": 3,
      "topic": "深海矿产资源",
      "category": "材料",
      "number": "约750亿",
      "unit": "吨（多金属结核，太平洋）",
      "context": "太平洋底部分布着约750亿吨多金属结核，含锰、镍、铜、钴等关键金属；深度约4000-6000m，开采技术和环境影响尚未解决，是“未来的矿山”。",
      "insight": "深海结核中的钴储量是陆地探明储量的数倍；钴是锂离子电池正极关键材料；深海采矿若商业化，将从根本上改变电池材料供应格局——但生态代价尚不可知。"
    }
  ]
