  "date": "2026-11-12",
  "data_items": [
    {
      "id": 1,
      "topic": "中国一棵树的年固碳量",
      "category": "生活",
      "number": "约18",
      "unit": "公斤CO₂/年",
      "context": "不同树种差异极大：速生桉树约30kg/年；松树约15kg；城市行道树由于空间限制约5-10kg。森林整体比单棵树高效得多。",
      "insight": "一辆燃油车年排放约2000-2500kg CO₂；需要约110-140棵成年树才能抵消！这就是为什么“种树抵碳”虽好，但根本上还需要减少化石能源的使用。"
    },
    {
      "id": 2,
      "topic": "一度电能做什么",
      "category": "生活",
      "number": "1",
      "unit": "度电≈多种用途",
      "context": "1度电可以：煮饭20碗，手机充电50次，笔记本电脑用10小时，100W灯泡亮10小时，或让电动车行驶约6-8公里。",
      "insight": "1度电在家庭电价约0.5-0.6元，工业约0.4-0.6元，光伏发电约0.15元；三者差距反映了输配电、税费、调峰等中间成本——“电贵”往往贵在这些中间环节。"
    },
    {
      "id": 3,
      "topic": "加氢站建设成本",
      "category": "氢能",
      "number": "1500~2500",
      "unit": "万元/座",
      "context": "加油站约100-200万元，充电站约30-100万元；加氢站成本高出10-20倍，主要因高压储氢设备、氢气压缩机造价高昂。",
      "insight": "全国目前约400座加氢站（2024年），而加油站超10万座；加氢基础设施密度不足，是制约氢能汽车普及的关键瓶颈之一。"
    }
  ]
}