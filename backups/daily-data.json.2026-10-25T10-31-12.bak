  "data_items": [
    {
      "id": 1,
      "topic": "一度电能做什么",
      "category": "生活",
      "number": "1",
      "unit": "度电≈多种用途",
      "context": "1度电可以：煮饭20碗，手机充电50次，笔记本电脑用10小时，100W灯泡亮10小时，或让电动车行驶约6-8公里。",
      "insight": "1度电在家庭电价约0.5-0.6元，工业约0.4-0.6元，光伏发电约0.15元；三者差距反映了输配电、税费、调峰等中间成本——“电贵”往往贵在这些中间环节。"
    },
    {
      "id": 2,
      "topic": "风电机组单机容量",
      "category": "能源",
      "number": "20",
      "unit": "兆瓦（海上最大）",
      "context": "2000年主流风机约500kW；2010年约1.5MW；2020年约3-5MW；2024年中国海上最大风机已达20MW，单台年发电约8000万度。",
      "insight": "一台20MW海上风机年发电量8000万度，可满足约2万户家庭用电；相比之下一座核电机组约100万kW，是一台大风机的50倍。"
    },
    {
      "id": 3,
      "topic": "全球飞机日均起降次数",
      "category": "社会",
      "number": "约10",
      "unit": "万次/天（疫情前）",
      "context": "疫情前全球每天约10万次航班；2020年降至约3万次；2024年恢复至约11万次。航空业碳排放约占全球2-3%，但高空排放的气候效应是地面的2-4倍。",
      "insight": "一次北京-纽约直飞（约13小时），每位乘客碳足迹约1.5吨CO₂，约等于一个中国农村居民3-4个月的全部排放——选择飞行频率，是个人碳足迹中影响最大的单一决策。"
    }
  ]
}