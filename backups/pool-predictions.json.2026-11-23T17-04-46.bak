[
  {"topic": "绿氢平价时间", "question": "绿氢（LCOH）在中国何时能与灰氢平价（约1.5元/m³）？", "stance": "乐观派认为2030年前；悲观派认为2040年后；现实派认为局部地区（青藏高原光伏充足区）2028年可实现。", "calibrate": "你现在的判断基于什么？绿电价格假设是多少？如果绿电降至0.1元/kWh，LCOH会到哪？"},
  {"topic": "AI替代科研人员", "question": "AI工具能否在2030年前独立完成一篇Top期刊的实验性论文（从假设到投稿）？", "stance": "技术层面已接近可行，但同行评审制度和学术信任体系是真正的瓶颈，判断可能性极低但不可忽视。", "calibrate": "区分“技术可行”和“制度接受”，你在哪个维度做判断？"},
  {"topic": "中国氢能车保有量", "question": "2030年中国氢燃料电池车的保有量能否达到100万辆？", "stance": "当前政策目标如此，但当前保有量（约2万辆）意味着需要50倍增长，历史上任何交通工具都没有实现过此速度。", "calibrate": "你愿意用多高的置信度押注这个目标？如果只有30%，政策设计是否需要修正？"},
  {"topic": "全固态电池商业化", "question": "全固态电池能否在2028年前进入量产乘用车？", "stance": "丰田、宁德时代都有明确时间表，但电池行业历史上量产时间表平均推迟3-5年。警惕过于乐观的官方预测。", "calibrate": "如果你是投资人，你会在这个赛道押注多少比例的组合？"},
  {"topic": "碳中和承诺的实现", "question": "中国能否在2060年实现碳中和承诺（不是碳达峰，是净零排放）？", "stance": "结构性可行，但依赖技术（CCUS大规模商业化）和政治意愿在未来30年保持连续性，两者都存在不确定性。", "calibrate": "你认为最大的技术障碍是什么？最大的政治障碍是什么？两者哪个更难克服？"},
  {"topic": "核聚变商业化", "question": "本世纪内（2099年前），商业化核聚变发电站能否接入电网？", "stance": "ITER等项目表明技术路径存在，但工程化挑战（材料疲劳、等离子体控制）远超预期。历史上“30年内”的预测被反复推迟60年。", "calibrate": "你对这个预测的置信度是多少？你会在私人聚变公司（Commonwealth Fusion等）投资吗？"},
  {"topic": "光伏发电成本", "question": "光伏发电度电成本能否在2030年跌破0.1元/kWh（中国平均水平）？", "stance": "在优质资源区（青海、新疆）已经实现，问题是能否推广到全国平均。电网消纳和储能成本是更大的限制因素。", "calibrate": "度电成本应该包含储能成本吗？不同的定义边界会给出完全不同的答案。"},
  {"topic": "量子计算机实用化", "question": "专用量子计算机（非通用）能否在2027年前在药物分子模拟领域超过最强经典计算机？", "stance": "已有初步迹象（谷歌、IBM的部分量子优势实验），但“实用场景中的超越”要求比实验室基准高得多。", "calibrate": "你如何区分“量子优势”（某测试题）和“量子实用”（真实价值）？"},
  {"topic": "可再生能源比例", "question": "2035年中国非化石能源发电占比能否超过60%？", "stance": "当前约37%，国家目标是2030年达到50%+。光伏和风电增速支持达标，但灵活性资源（储能、调峰）是瓶颈。", "calibrate": "如果储能成本降速低于预期，这个目标会推迟多久？你的模型中储能成本假设是什么？"},
  {"topic": "大语言模型能力上限", "question": "当前的大语言模型架构（Transformer）能否在不改变基本架构的情况下实现真正的推理能力（而非模式匹配）？", "stance": "几乎所有顶级AI研究者意见分歧极大，这本身就是信号——这是真正的未知领域，而非可信预测的范畴。", "calibrate": "你如何定义“真正的推理”？你是否有可操作的测试来区分它和“非常好的模式匹配”？"},
  {"topic": "中美科技脱钩", "question": "未来5年，中美之间的科技脱钩（芯片、AI、清洁能源）会加速还是放缓？", "stance": "结构性力量（安全逻辑、选举政治、技术竞争）指向加速，但经济互依存和企业游说力量指向局部缓和。净效应取决于具体事件的触发。", "calibrate": "你如何预测这类取决于“关键事件”的问题？应该押注基本力量还是等待触发点？"},
  {"topic": "CCUS商业化", "question": "碳捕获与封存（CCUS）技术能否在2035年前实现100美元/吨以下的捕获成本（使其在碳价>100美元时有经济性）？", "stance": "当前成本50-120美元/吨（地质条件相关），学习曲线类似早期光伏，但规模化路径仍不清晰。", "calibrate": "你认为CCUS的成本曲线斜率和光伏相比更陡还是更平？理由是什么？"},
  {"topic": "人口与创新", "question": "中国人口下降趋势能否在2050年前对技术创新产生可观测的负面影响？", "stance": "短期（10年内）影响小，因为人口红利衰退被教育水平提升部分对冲。长期（30年+）机器人和AI可能比人口更能决定创新速率。", "calibrate": "你认为创新的核心驱动力是人口数量、人口结构，还是机构设计？"},
  {"topic": "氨作为氢能载体", "question": "液氨作为氢的远距离运输载体能否在2030年前实现商业化规模应用？", "stance": "日本-澳大利亚供应链已有项目落地，技术可行性基本确认，瓶颈在于安全合规标准和进口侧的分解成本。", "calibrate": "你认为哪个技术障碍是最后一个被克服的：合成效率、运输安全，还是终端分解成本？"},
  {"topic": "电动飞机", "question": "中短途（<500km）电动客机能否在2035年前进入商业运营？", "stance": "起步阶段已有小型电动飞机（9座以下）进入认证，但百座以上的商业客机受限于能量密度，在2035年前几乎不可能达到经济性平衡点。", "calibrate": "这道题的核心约束是电池能量密度，你认为2035年能达到多少Wh/kg？这足够吗？"},
  {"topic": "项目交付", "question": "下次组会前能完成几组通过质量检查的实验？", "stance": "用过去四周实际通过的组数作为起点，另列设备停机的影响。", "calibrate": "现在写下区间和概率，到组会时只统计通过检查的组数。"},
  {"topic": "阅读迁移", "question": "一周后能否脱稿讲清今天读过的一篇论文？", "stance": "熟悉图表和能解释因果关系是两项不同能力。", "calibrate": "预先写下三道问题，一周后闭卷回答并核对。"},
  {"topic": "排队时间", "question": "下次送样能否在三个工作日内拿到结果？", "stance": "样品数之外，还要考虑共享仪器的队列。", "calibrate": "记录提交时间、开测时间与完成时间，分别核对等待和处理时长。"},
  {"topic": "误差来源", "question": "更换同批次样品后，测试差异会超过仪器重复性吗？", "stance": "仪器重复测量与换样测量提供两层误差参照。", "calibrate": "提前定义超过的阈值，用盲编号核对判断。"},
  {"topic": "协作返工", "question": "在需求中加入一条验收示例，下次返工次数会减少吗？", "stance": "返工也可能受任务难度影响。", "calibrate": "事先定义返工，选两个规模接近的任务比较。"},
  {"topic": "系统边界复核", "question": "比较两种制氢路线时，是否都把压缩和纯化计入耗电？", "stance": "只比较槽体会漏掉交付相同产品所需的辅助能耗。", "calibrate": "在看数据前写下预期方向和置信度。以相同出口压力和纯度重新核算每公斤电耗。"},
  {"topic": "时间对齐复核", "question": "两条产线的功率与产量记录是否使用同一时钟？", "stance": "时钟偏移会让输入变化看起来发生在输出之后。", "calibrate": "在看数据前写下预期方向和置信度。用一次已知启停事件检查时间戳。"},
  {"topic": "删失数据复核", "question": "寿命试验结束时仍在运行的设备该怎样计入？", "stance": "只平均已失效样品会忽略尚未观察到的寿命。", "calibrate": "在看数据前写下预期方向和置信度。同时记录观察截止日和失效标记。"},
  {"topic": "测量溯源复核", "question": "两块流量计读数不同时，校准记录能追溯到哪里？", "stance": "仪表间一致不能排除共同的系统误差。", "calibrate": "在看数据前写下预期方向和置信度。核对参考标准、不确定度和校准日期。"},
  {"topic": "抽样框复核", "question": "客户满意度调查里，已经停止订货的人还有机会回答吗？", "stance": "联系名单会决定哪些经历可以进入统计。", "calibrate": "在看数据前写下预期方向和置信度。分别列出现有客户与流失客户的覆盖率。"},
  {"topic": "负荷持续曲线复核", "question": "全年可利用功率足以覆盖多少小时的额定负荷？", "stance": "按功率排序有利于估容量，却丢失连续低谷的顺序。", "calibrate": "在看数据前写下预期方向和置信度。再用原始小时序列复核储量需求。"},
  {"topic": "库存覆盖时间复核", "question": "如果来料中断，现有库存能支持多少小时交付？", "stance": "按库存除以消耗率估算时必须先扣除不可用底量。", "calibrate": "在看数据前写下预期方向和置信度。分别计算正常工况与高峰工况。"},
  {"topic": "滞回控制复核", "question": "为什么设备开和关需要两条不同的阈值？", "stance": "阈值过近会把测量噪声放大成频繁切换。", "calibrate": "在看数据前写下预期方向和置信度。比较单位时间切换次数及越限持续时间。"},
