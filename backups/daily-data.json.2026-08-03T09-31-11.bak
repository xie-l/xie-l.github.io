  "data_items": [
    {
      "id": 1,
      "topic": "青海省太阳能资源",
      "category": "能源",
      "number": "约1700~2800",
      "unit": "小时/年（年利用小时）",
      "context": "青海太阳能资源全国第二，年辐射总量约5500-7500MJ/m²；格尔木、德令哈地区是全国最优质的光伏基地，年等效满负荷小时数超2200小时。",
      "insight": "同样1GW光伏装机，青海年发电22亿度，而安徽仅约13亿度——资源差异近1倍。“追阳光”是绿氢降本的重要策略，青海恰好是国内制绿氢成本最低的地区之一。"
    },
    {
      "id": 2,
      "topic": "加氢站建设成本",
      "category": "氢能",
      "number": "1500~2500",
      "unit": "万元/座",
      "context": "加油站约100-200万元，充电站约30-100万元；加氢站成本高出10-20倍，主要因高压储氢设备、氢气压缩机造价高昂。",
      "insight": "全国目前约400座加氢站（2024年），而加油站超10万座；加氢基础设施密度不足，是制约氢能汽车普及的关键瓶颈之一。"
    },
    {
      "id": 3,
      "topic": "成年人每日热量需求",
      "category": "生活",
      "number": "2000~2500",
      "unit": "大卡/天",
      "context": "轻体力劳动者约2000大卡；中度约2500；重体力约3000+。一块200g巧克力约1100大卡，几乎是一天的一半；一碗米饭约200大卡。",
      "insight": "2500大卡折合约2.9度热量（1大卡≈1.16Wh）；人体每天消耗的能量相当于约3度电——比一台电脑（50-100W×24h≈1.2-2.4度）还多！人体其实是台高效的能量机器。"
    }
  ]
}