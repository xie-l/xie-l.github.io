[
  {"scenario": "你研究了某电解槽技术三年，投入大量精力。新来的同事提出一个完全不同的技术路线，你的第一反应是列出它的种种缺点。", "bias": "沉没成本谬误", "desc": "过去的投入（时间、精力）左右了你对新方案的客观评估，你在保护投入而非追求真相。", "counter": "问自己：如果从零开始，我会选择哪个路线？把已投入的成本暂时“遗忘”再做判断。"},
  {"scenario": "你读到三篇都支持绿氢大规模商业化的报道，开始相信这个判断。但实际上你主动搜索时倾向于点击支持这一观点的文章。", "bias": "确认偏误", "desc": "大脑会优先搜索和记忆符合已有信念的信息，忽视反例。三篇报道并不代表全貌。", "counter": "主动搜索“绿氢商业化的挑战/失败案例”，刻意寻找与自己观点相反的强力论据。"},
  {"scenario": "你在会议上提出了一个想法，老板点头表示认可，随后整个团队都纷纷表示支持。你认为这个想法确实很好。", "bias": "权威偏误+从众效应", "desc": "老板的认可是社会信号，不是逻辑验证。团队的支持可能只是对权威的顺从，而非独立判断。", "counter": "在会议结束后，私下询问2-3个思维独立的同事：这个方案最大的漏洞是什么？"},
  {"scenario": "你的上一个项目成功了，你认为主要是因为自己的决策正确。团队说了很多，但你在心里把大部分功劳归于自己。", "bias": "自我服务偏误", "desc": "成功时高估自己的贡献，失败时高估外部因素。这会阻碍真实的经验学习。", "counter": "写下这个项目成功中，哪些是运气、时机和队友的贡献？至少写出三条。"},
  {"scenario": "你看到一家氢能公司的创始人在B站上侃侃而谈，口才极佳，你觉得这家公司一定很靠谱。", "bias": "光环效应", "desc": "某人在一个维度表现优秀（口才、颜值、知名度），会让你高估其在其他维度（技术实力、诚信）的表现。", "counter": "把口才从你的评价框架中剥离，专门看：他们的产品数据、交付记录、财务状况如何？"},
  {"scenario": "行业大会上，演讲者举了一个绿氢项目在挪威大获成功的案例，你深受启发，开始相信这个模式可以复制到中国。", "bias": "典型性启发（可得性偏误）", "desc": "生动、具体的成功案例在记忆中权重过高。挪威有廉价水电、高碳税，这些条件在中国不可直接复制。", "counter": "问：这个案例成立的关键假设是什么？这些假设在我的场景中有几个成立？"},
  {"scenario": "你第一次听说碳捕获技术时觉得它很贵、不靠谱，后来无论看到什么新证据，这种第一印象都很难改变。", "bias": "锚定效应", "desc": "第一个接收到的信息成为认知锚点，后续信息都被相对于这个锚进行调整，而非独立评估。", "counter": "把已知信息清空，重新问：如果今天才第一次了解这项技术，我会怎么评价它的现状？"},
  {"scenario": "同事说了一件事，时间、地点、人物、情节都很完整，你觉得这一定是真的。但实际上细节越多不代表越可靠。", "bias": "叙事谬误（故事性偏误）", "desc": "大脑喜欢完整的故事，越流畅的叙事越可信。但故事性和真实性是两件事。", "counter": "询问：这件事有独立来源可以核实吗？还是只有一个叙述者？"},
  {"scenario": "你跑步坚持了21天，认为习惯已经养成了，于是放松了对自己的要求，结果第22天没跑，之后就断了。", "bias": "虚假进步感（过早庆功）", "desc": "习惯养成所需时间因行为复杂度而异，远不止21天。提前认定成功会降低警觉性。", "counter": "不要定一个“养成日”，而是把执行本身作为习惯的锚点，减少对“养成”里程碑的关注。"},
  {"scenario": "氢能板块最近三个月大涨，你认为趋势还会持续，准备重仓押注。", "bias": "热手谬误", "desc": "把短期的随机涨跌误认为是可持续的趋势。短期相关性经常被人脑误读为规律。", "counter": "问：这个涨势背后有什么新的基本面变化，还是纯粹是情绪驱动的资金流？基本面能支撑估值吗？"},
  {"scenario": "你完成了一份报告，仔细修改了三遍，觉得没什么问题了。让同事看时，他发现了你根本没注意到的逻辑漏洞。", "bias": "知识的诅咒（盲点偏误）", "desc": "当你对某事了解越深，越难想象不了解它的人如何理解它。你自动填补了读者的认知空白。", "counter": "找一个对此话题完全陌生的人来读，听他们的困惑，那些困惑就是你的盲点。"},
  {"scenario": "你预测某项目明年可以盈利，但拆解后发现你的预测没有考虑任何不利情形，全都是顺利推进的假设。", "bias": "规划谬误", "desc": "制定计划时系统性地低估风险、高估效率，高估自己对未来的控制力。", "counter": "做三情境分析：乐观情境（10%概率）、基准情境（60%）、悲观情境（30%）。用期望值而非乐观值决策。"},
  {"scenario": "你参加一个会议，发言只占10%的时间，但事后回忆时，自己的发言占了记忆内容的40%以上。", "bias": "以自我为中心的记忆偏差", "desc": "大脑在记忆中对自己相关的信息给予过高权重，导致高估自己在社交场合的存在感。", "counter": "主动记录他人的发言要点，客观回顾自己的输出占比，训练“去中心化”的观察力。"},
  {"scenario": "你的朋友投资了一个失败的氢能项目，损失惨重。你因此得出结论：氢能投资风险太大，不可触碰。", "bias": "可得性启发（情绪权重过高）", "desc": "近期的、情绪强烈的事件在决策中被过度权重，取代了对总体数据的理性分析。", "counter": "查找更大样本：氢能领域中成功退出的投资案例是什么比例？基于数据而非个案做判断。"},
  {"scenario": "你的新同事被介绍为“名校毕业、获奖无数”，于是你认为他的每个建议都比普通同事更值得信任。", "bias": "资历偏误", "desc": "过去的学历和荣誉作为预测未来表现的单一标准，而忽视当前情境中的实际能力表现。", "counter": "针对具体问题独立评估：这个建议的逻辑和证据是什么？和提建议者的资历分开看。"},
  {"scenario": "你写了一篇分析报告，提出绿氢在2030年将取代大量化石能源。你越写越确信，因为每次论证都让你更投入。", "bias": "过度自信效应", "desc": "思考和表达的流畅感让人误以为自己的判断更可靠。越投入，越容易高估自己的准确率。", "counter": "在完成报告后，问自己：我在多大程度上愿意用自己的资金赌这个结论？如果不敢，说明置信度被高估了。"},
  {"scenario": "新闻标题：某地氢能事故导致爆炸！你立刻认为氢能的安全风险被极大低估，技术路线不靠谱。", "bias": "负面偏误", "desc": "负面事件在认知中权重远高于正面事件。一个爆炸新闻的影响力可以抵消数十个成功运营报道。", "counter": "寻找基准数据：化石燃料行业同期的安全事故频率是多少？氢能事故的比例在同类能源中处于什么位置？"},
  {"scenario": "你在谈判前读到了对方公司一些负面新闻，整场谈判中你都处于提防状态，甚至拒绝了几个合理的提案。", "bias": "框架效应（先入为主）", "desc": "信息呈现的顺序和框架影响了判断。负面信息的先行植入使整个评估过程带上了有色滤镜。", "counter": "在重要决策前，明确你的评估框架，写下“我关注的核心指标”，让框架在先，而非情绪。"},
  {"scenario": "你的团队每次碰到困难，大家首先想到的总是“要不要加人手”，而不是先检查流程是否有问题。", "bias": "工具偏误（用锤子找钉子）", "desc": "我们倾向于用自己最熟悉的解决方案来应对问题，而非先理解问题的本质。", "counter": "在提出解决方案前，先花10分钟描述问题：什么在失灵？为什么失灵？根本原因是什么？"},
  {"scenario": "你对某位创业者印象很好，他们逻辑清晰、思维敏捷，让你觉得投资他们的公司大概率会成功。", "bias": "人际吸引力偏误", "desc": "我们对让自己感到愉悦的人更容易产生正面判断，而这种感受和能力、商业可行性无关。", "counter": "区分“我喜欢这个人”和“这个商业模式在市场中是否成立”。用不同的框架独立评估人和业务。"},
  {"scenario": "同事提出的新流程方案你看起来很繁琐，觉得不如现在的方法。但其实你只是因为不熟悉而感到不适。", "bias": "现状偏误", "desc": "对当前状态的维护倾向，倾向于高估改变的代价、低估改变的收益。", "counter": "问：如果两个方案都是新的，我会选哪个？把现状从评估中去掉，用“全新出发”的视角比较。"},
  {"scenario": "你听说某技术“全球已有100+项目部署”，觉得这说明它已经成熟可靠了。", "bias": "数量启发", "desc": "项目数量不等于质量、可靠性或适用性。大量小型试点项目的存在并不等于技术商业化成熟。", "counter": "追问：这100个项目的规模分布？成功率？商业化运营的比例？数量只是第一层，深度才是关键。"},
  {"scenario": "你在向领导汇报时，对方中途皱了一下眉头，你立刻认为他对你的方案不满意，开始紧张并修改思路。", "bias": "读心术错误（投射偏误）", "desc": "把他人行为（皱眉）解读为与自己相关的负面信号，而实际上可能只是他在思考，或有其他原因。", "counter": "不要根据对方的面部表情中途调整，完整表达后再问：您对哪些方面有疑问或不同看法？"},
  {"scenario": "你的团队头脑风暴时，第一个被提出来的方案获得了最多的讨论时间，最终被采纳，尽管后来有更好的想法。", "bias": "首先性效应（先入优势）", "desc": "最早进入讨论的想法占据了注意力中心，后来的想法在比较时系统性处于劣势。", "counter": "规定所有人先独立思考并写下方案，然后同时展示（匿名更佳），再开始讨论，打破顺序优势。"},
  {"scenario": "你连续三次做到了自己承诺的事情，开始相信自己是一个高度自律的人，于是降低了对自己的监控频率。", "bias": "道德许可效应", "desc": "过去的好行为给予了“许可证”，让我们在未来做出更少努力。好行为是累积性的，不是抵消性的。", "counter": "把好行为看作系统的输出而非个人品质，维持系统（提醒机制）而非依赖自我信念。"},
  {"scenario": "你阅读一篇关于氢能未来的文章，文章中充满了宏大叙事和鼓舞人心的语言，让你感到振奋并觉得这一定是正确的。", "bias": "情感启发", "desc": "情感状态（振奋、恐惧）左右判断。让人感觉好的信息不一定是准确的信息。", "counter": "阅读完后，等待情绪平复（比如隔天），再用逻辑框架重新审视：核心论点是否有数据支撑？"},
  {"scenario": "你的实验结果第一次呈现了一个有趣的现象，你的直觉告诉你这是真实的，于是设计后续实验来支持这一发现。", "bias": "双重标准（支持自己假设的实验设计偏误）", "desc": "无意识地设计更容易验证假设的实验，而非试图证伪它。科学进步依赖于寻找反例。", "counter": "问：什么实验结果会让我放弃这个假设？然后去做那个实验。"},
  {"scenario": "你完成了一份长篇分析后，回顾结论时觉得“这些本来就是显而易见的”，忘记了自己当初花了多少时间才得出结论。", "bias": "后见之明偏误", "desc": "事件发生后，我们往往觉得它是“早就可以预测的”，低估了预测的难度，损害了对未来不确定性的尊重。", "counter": "在开始分析之前，写下你的初始预测和置信度，事后对比，训练对不确定性的真实感知。"},
  {"scenario": "你在一个陌生城市，发现路上99%都是骑自行车的人，你立刻推断：这个城市的人肯定都很注重健康生活。", "bias": "幸存者偏误（可见性选择）", "desc": "你只看到了此时此地出现在你视野中的人，无法看到那些不骑车的人（在室内、在地铁、在工作）。", "counter": "问：我现在看到的是整体样本的随机切片，还是某种筛选机制的产物？还有什么是我看不到的？"},
  {"scenario": "审查案例：比较两种制氢路线时，是否都把压缩和纯化计入耗电？", "bias": "忽略系统边界", "desc": "只比较槽体会漏掉交付相同产品所需的辅助能耗。", "counter": "以相同出口压力和纯度重新核算每公斤电耗。"},
  {"scenario": "审查案例：两条产线的功率与产量记录是否使用同一时钟？", "bias": "忽略时间对齐", "desc": "时钟偏移会让输入变化看起来发生在输出之后。", "counter": "用一次已知启停事件检查时间戳。"},
  {"scenario": "审查案例：寿命试验结束时仍在运行的设备该怎样计入？", "bias": "忽略删失数据", "desc": "只平均已失效样品会忽略尚未观察到的寿命。", "counter": "同时记录观察截止日和失效标记。"},
  {"scenario": "审查案例：两块流量计读数不同时，校准记录能追溯到哪里？", "bias": "忽略测量溯源", "desc": "仪表间一致不能排除共同的系统误差。", "counter": "核对参考标准、不确定度和校准日期。"},
  {"scenario": "审查案例：客户满意度调查里，已经停止订货的人还有机会回答吗？", "bias": "忽略抽样框", "desc": "联系名单会决定哪些经历可以进入统计。", "counter": "分别列出现有客户与流失客户的覆盖率。"},
  {"scenario": "审查案例：全年可利用功率足以覆盖多少小时的额定负荷？", "bias": "忽略负荷持续曲线", "desc": "按功率排序有利于估容量，却丢失连续低谷的顺序。", "counter": "再用原始小时序列复核储量需求。"},
  {"scenario": "审查案例：如果来料中断，现有库存能支持多少小时交付？", "bias": "忽略库存覆盖时间", "desc": "按库存除以消耗率估算时必须先扣除不可用底量。", "counter": "分别计算正常工况与高峰工况。"},
  {"scenario": "审查案例：为什么设备开和关需要两条不同的阈值？", "bias": "忽略滞回控制", "desc": "阈值过近会把测量噪声放大成频繁切换。", "counter": "比较单位时间切换次数及越限持续时间。"},
  {"scenario": "审查案例：两台备用机是否共用同一条供电线路？", "bias": "忽略共因故障", "desc": "重复配置无法自动消除共享依赖造成的同时失效。", "counter": "画出两条路径并圈出共享节点。"},
  {"scenario": "审查案例：订单增加多久以后才会反映到交付量上？", "bias": "忽略滞后指标", "desc": "不同指标描述的是过程中的不同阶段。", "counter": "按订单月份分组跟踪实际交付。"},
  {"scenario": "审查案例：小试装置表现良好，放大后哪个比例先变了？", "bias": "忽略尺度效应", "desc": "体积和换热面积随尺寸增长的速度不同。", "counter": "列出单位体积可用面积随尺寸的关系。"},
  {"scenario": "审查案例：两套参数能否给出几乎一样的拟合曲线？", "bias": "忽略可辨识性", "desc": "拟合吻合不代表各参数都能被数据单独确定。", "counter": "寻找两组预测分歧最大的补充测量。"},
  {"scenario": "审查案例：新报表是否把功率和电量加在了同一列？", "bias": "忽略量纲一致性", "desc": "数值单位能帮助识别许多看似合理的错误。", "counter": "逐项写出乘除之后剩余的单位。"},
  {"scenario": "审查案例：同一标准样在月底和月初的读数一致吗？", "bias": "忽略基准漂移", "desc": "仪器响应随时间变化会伪装成材料性能变化。", "counter": "将标准样穿插在采样顺序中。"},
  {"scenario": "审查案例：新工艺的测试是否恰好都安排在较凉的时段？", "bias": "忽略混杂因素", "desc": "处理条件与环境因素同时变化会妨碍归因。", "counter": "在相同环境分层比较两种工艺。"},
  {"scenario": "审查案例：能否在同一批原料上比较两种处理方法？", "bias": "忽略配对比较", "desc": "用配对差值可削弱批次间差异。", "counter": "保存配对编号并画出每一对的差值。"},
  {"scenario": "审查案例：平均交付时间很好，最慢的十分之一要等多久？", "bias": "忽略尾部风险", "desc": "少量极慢事件可能决定客户是否需要备用库存。", "counter": "同时报告中位数和高分位数。"},
  {"scenario": "审查案例：下一小时功率够用，装置来得及达到所需负荷吗？", "bias": "忽略爬坡约束", "desc": "满足静态容量不代表能够满足变化速率。", "counter": "逐时检查相邻设定值的差。"},
  {"scenario": "审查案例：模型是否被用于训练数据从未覆盖的温度区间？", "bias": "忽略外推误差", "desc": "区间外即使预测曲线平滑也可能偏离实际。", "counter": "标出训练范围并单列区间外验证结果。"},
  {"scenario": "审查案例：比较包装材料时，按每千克还是每次合格配送核算？", "bias": "忽略功能单位", "desc": "轻量材料若损耗更高，两种比较可能得出相反排序。", "counter": "统一交付功能再统计全程消耗。"},
