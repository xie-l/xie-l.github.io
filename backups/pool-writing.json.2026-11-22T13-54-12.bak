[
  {"prompt": "写一封信给5年后的自己。不要写期望，只写此刻让你感到真实不安的一件事，以及你正在怎么应对它。", "hint": "避免励志套话，聚焦具体的内心活动。", "goal": "训练诚实自我观察，区分表演性表达与真实感受。"},
  {"prompt": "用一段话解释“绿氢”，不使用任何专业术语，让一个10岁的孩子能听懂。", "hint": "想象孩子问：为什么要这么麻烦用电把水分开？不如直接用电？", "goal": "检验深度理解，培养化繁为简的表达能力。"},
  {"prompt": "描述一个你曾经非常坚信、后来被证明完全错误的判断。是什么改变了你的想法？", "hint": "不要停在“我认识到了”，要写改变发生的那个具体时刻。", "goal": "训练反事实思维，增强认知的可纠错性。"},
  {"prompt": "如果今天要从头设计你的日常工作节奏，不受现有习惯限制，你会怎么安排这8小时？", "hint": "从自己的能量曲线出发，而非从“应该怎样”出发。", "goal": "培养主动设计生活的意识，而非被动适应。"},
  {"prompt": "写一个你最近观察到的、让你觉得“这个行业比外界想象的更复杂”的细节。", "hint": "越具体越好：一个数字、一个现象、一句话。", "goal": "训练行业嗅觉，培养从细节读出系统性规律的能力。"},
  {"prompt": "描述一次你做了正确决定但结果很糟糕的事情。或者一次错误决定但结果很好的事情。", "hint": "重点在于剥离决策质量和结果运气。", "goal": "训练过程思维，避免以结果论英雄。"},
  {"prompt": "用100字以内，把你目前最重要的一个工作挑战，表达得足够清晰，让任何人都能理解它的核心困难所在。", "hint": "第一稿往往过于专业，重写一遍去掉所有行话。", "goal": "训练问题定义能力，清晰表达是解决问题的前提。"},
  {"prompt": "写一位让你印象深刻的人，不是他们的成就，而是他们做的某一个具体的小动作或说的某一句话。", "hint": "细节胜过总结，“他停下来认真听完”比“他很尊重人”更有力。", "goal": "训练人物观察力和具体性写作，避免空洞的形容词。"},
  {"prompt": "如果你现在必须向一个投资人解释：为什么中国的氢能产业在未来5年内值得关注？用3个论据，每个论据不超过2句话。", "hint": "逻辑清晰比全面更重要，选最有力的3个。", "goal": "训练结构化思维和说服性表达。"},
  {"prompt": "描述一个让你在工作中感到真正有成就感的时刻（而非表面上应该感到自豪的时刻）。它跟你的外部评价有多大差距？", "hint": "把内在满足和外部认可分开写，诚实面对两者的差距。", "goal": "澄清真实的价值驱动，而非表演性的成就追求。"},
  {"prompt": "如果你只能选择一本书推荐给刚进入能源行业的朋友，你会选哪本？用一段话说明它为什么值得读，而不只是介绍内容。", "hint": "重点在于“为什么这本书改变了你的思考方式”。", "goal": "训练价值判断的表达，同时澄清对自身成长的理解。"},
  {"prompt": "你上一次因为“没时间”而推迟的事情是什么？如果时间真的足够，你会做吗？诚实回答。", "hint": "如果答案是“不会”，那真正的原因是什么？", "goal": "训练对拖延和真实意愿的自我诚实。"},
  {"prompt": "写下当前工作中你最担心自己在5年内会被替代的部分，以及你准备怎么应对。", "hint": "不要写理想化答案，写你真正在做的事（哪怕很少）。", "goal": "训练职业危机感知和主动应对能力。"},
  {"prompt": "用一段话描述你理想中的“一天”，不是假期，而是工作日。你的工作方式、人际互动、思考空间应该是什么样的？", "hint": "越具体越好，比如：上午是独处时间还是开会？开什么样的会？", "goal": "澄清对理想工作状态的真实想象，发现与现实的差距。"},
  {"prompt": "选一个最近让你感到无聊的事情，试着写出它可能有趣的三个角度。", "hint": "强迫自己找到第3个角度，最后一个往往是最有价值的。", "goal": "训练认知重构能力，在枯燥中发现价值。"},
  {"prompt": "写一段“说服自己在未来3个月内不学新东西的理由”。（是的，写反面。）", "hint": "认真写，找出它的内在逻辑，这会让你看到自己的惰性结构。", "goal": "通过反向写作揭示潜意识中的阻力，从而更容易克服它。"},
  {"prompt": "描述一个你曾经非常不喜欢的人，然后试着用最有同理心的方式解释他们当时的行为。", "hint": "不是为了原谅，而是为了理解动机的多样性。", "goal": "训练换位思考能力和对人类行为复杂性的理解。"},
  {"prompt": "如果你今天是行业记者，你会写哪个关于氢能的故事，是还没有人写到的？", "hint": "这个问题会暴露你的行业观察视角和信息处理方式。", "goal": "训练行业洞察力和叙事框架的建立能力。"},
  {"prompt": "写下你最近一次改变了别人想法的经历（或者别人改变了你想法的经历）。是什么让这次改变发生了？", "hint": "关注是什么触发了改变：逻辑？情感？新事实？恰当时机？", "goal": "研究说服力的真实机制，而非理论模型。"},
  {"prompt": "你现在最想拥有什么能力？为什么你还没有开始系统训练它？", "hint": "诚实写出拖延的真实原因，而不是“没时间”这种托词。", "goal": "训练自我觉察，识别拖延背后的真正阻力。"},
  {"prompt": "选择一个你认为未来10年内会彻底改变的行业（除了你自己所在的领域），说明你为什么这样判断。", "hint": "尝试找到别人没有注意到的变化信号。", "goal": "训练跨领域的趋势判断力和预测思维。"},
  {"prompt": "描述一次你“被数据欺骗”的经历——数据是真实的，但结论是错的。", "hint": "可以是自己的经历，也可以是你目睹他人犯的错误。", "goal": "训练批判性数据思维，理解数据与推论之间的鸿沟。"},
  {"prompt": "用一段话写出你认为自己最被低估的能力，以及你打算怎么让它被更好地看见。", "hint": "不是自夸，而是诚实评估：这个能力在什么场景下会产生真正价值？", "goal": "训练自我认知和个人品牌建设意识。"},
  {"prompt": "描述一个你学到的最反直觉的科学事实或行业规律。它如何改变了你的日常决策？", "hint": "“改变决策”是检验“真正学到”的标准，而不只是“知道了”。", "goal": "区分信息积累和真正的认知迭代。"},
  {"prompt": "如果你必须在接下来90天内让某个工作成果显著提升，你会聚焦在哪个最有杠杆效应的点上？", "hint": "限定“一个点”的目的是强迫你做出优先级判断，而不是列出所有要做的事。", "goal": "训练聚焦思维和优先级判断力。"},
  {"prompt": "写一个你曾经持有很长时间但最近放弃的信念，以及是什么让你放弃了它。", "hint": "放弃信念需要诚实，也需要具体——是什么事实或逻辑让你转变的？", "goal": "训练信念更新能力，抵抗认知惰性。"},
  {"prompt": "如果你必须花一年时间研究一个与你当前专业完全无关的主题，你会选什么？为什么？", "hint": "你的选择本身就是一个关于你真正兴趣的自我揭示。", "goal": "探索潜在的跨域热情，发现未被激活的认知资产。"},
  {"prompt": "描述你在工作中遇到的一个经常被忽视的假设，如果这个假设是错的，整个策略会发生什么变化？", "hint": "每个战略背后都有隐藏假设，关键是把它们显性化。", "goal": "训练批判性假设识别能力，提升策略健壮性。"},
  {"prompt": "你的朋友或同事说了一句让你深受启发的话，是什么？为什么它能让你停下来思考？", "hint": "用一段话解释：这句话触动你是因为它说出了你早已知道但从未表达的东西，还是因为它完全颠覆了你的预设？", "goal": "训练对语言精确性的敏感度和灵感来源的反思。"},
  {"prompt": "如果你可以给自己5年前写一封信，只说一件关于职业发展的事，你会写什么？", "hint": "不是回顾，而是聚焦于那个“如果早知道就好了”的关键认知。", "goal": "通过回溯澄清当前最重要的认知升级。"},
  {"prompt": "把今天最难解释的一张图讲给刚入组的同学。", "hint": "先说横纵轴的单位，再指出一个观察和一个尚待验证的解释。", "goal": "区分观察与解释。"},
  {"prompt": "写一份实验交接便条。", "hint": "只写接手的人明早需要知道的样品状态、异常和第一步。", "goal": "让记录能直接支持行动。"},
  {"prompt": "为一条新闻写两个标题。", "hint": "一条突出数量，另一条突出比较基准，核对两者是否都忠于原文。", "goal": "练习准确概括。"},
  {"prompt": "给一个失败的方案写结项说明。", "hint": "保留可复用的发现，并指出下次何时应提前停止。", "goal": "把失败转成可检查的经验。"},
  {"prompt": "描述一次你改变主意的过程。", "hint": "写出原判断、触发改变的证据，以及仍未解决的问题。", "goal": "练习更新判断。"},
  {"prompt": "写一段关于“系统边界”的交接说明。", "hint": "比较两种制氢路线时，是否都把压缩和纯化计入耗电？ 附上一项需要接手者核查的记录。", "goal": "以相同出口压力和纯度重新核算每公斤电耗。"},
  {"prompt": "写一段关于“时间对齐”的交接说明。", "hint": "两条产线的功率与产量记录是否使用同一时钟？ 附上一项需要接手者核查的记录。", "goal": "用一次已知启停事件检查时间戳。"},
  {"prompt": "写一段关于“删失数据”的交接说明。", "hint": "寿命试验结束时仍在运行的设备该怎样计入？ 附上一项需要接手者核查的记录。", "goal": "同时记录观察截止日和失效标记。"},
  {"prompt": "写一段关于“测量溯源”的交接说明。", "hint": "两块流量计读数不同时，校准记录能追溯到哪里？ 附上一项需要接手者核查的记录。", "goal": "核对参考标准、不确定度和校准日期。"},
  {"prompt": "写一段关于“抽样框”的交接说明。", "hint": "客户满意度调查里，已经停止订货的人还有机会回答吗？ 附上一项需要接手者核查的记录。", "goal": "分别列出现有客户与流失客户的覆盖率。"},
  {"prompt": "写一段关于“负荷持续曲线”的交接说明。", "hint": "全年可利用功率足以覆盖多少小时的额定负荷？ 附上一项需要接手者核查的记录。", "goal": "再用原始小时序列复核储量需求。"},
  {"prompt": "写一段关于“库存覆盖时间”的交接说明。", "hint": "如果来料中断，现有库存能支持多少小时交付？ 附上一项需要接手者核查的记录。", "goal": "分别计算正常工况与高峰工况。"},
  {"prompt": "写一段关于“滞回控制”的交接说明。", "hint": "为什么设备开和关需要两条不同的阈值？ 附上一项需要接手者核查的记录。", "goal": "比较单位时间切换次数及越限持续时间。"},
  {"prompt": "写一段关于“共因故障”的交接说明。", "hint": "两台备用机是否共用同一条供电线路？ 附上一项需要接手者核查的记录。", "goal": "画出两条路径并圈出共享节点。"},
  {"prompt": "写一段关于“滞后指标”的交接说明。", "hint": "订单增加多久以后才会反映到交付量上？ 附上一项需要接手者核查的记录。", "goal": "按订单月份分组跟踪实际交付。"},
  {"prompt": "写一段关于“尺度效应”的交接说明。", "hint": "小试装置表现良好，放大后哪个比例先变了？ 附上一项需要接手者核查的记录。", "goal": "列出单位体积可用面积随尺寸的关系。"},
  {"prompt": "写一段关于“可辨识性”的交接说明。", "hint": "两套参数能否给出几乎一样的拟合曲线？ 附上一项需要接手者核查的记录。", "goal": "寻找两组预测分歧最大的补充测量。"},
  {"prompt": "写一段关于“量纲一致性”的交接说明。", "hint": "新报表是否把功率和电量加在了同一列？ 附上一项需要接手者核查的记录。", "goal": "逐项写出乘除之后剩余的单位。"},
  {"prompt": "写一段关于“基准漂移”的交接说明。", "hint": "同一标准样在月底和月初的读数一致吗？ 附上一项需要接手者核查的记录。", "goal": "将标准样穿插在采样顺序中。"},
  {"prompt": "写一段关于“混杂因素”的交接说明。", "hint": "新工艺的测试是否恰好都安排在较凉的时段？ 附上一项需要接手者核查的记录。", "goal": "在相同环境分层比较两种工艺。"},
  {"prompt": "写一段关于“配对比较”的交接说明。", "hint": "能否在同一批原料上比较两种处理方法？ 附上一项需要接手者核查的记录。", "goal": "保存配对编号并画出每一对的差值。"},
  {"prompt": "写一段关于“尾部风险”的交接说明。", "hint": "平均交付时间很好，最慢的十分之一要等多久？ 附上一项需要接手者核查的记录。", "goal": "同时报告中位数和高分位数。"},
  {"prompt": "写一段关于“爬坡约束”的交接说明。", "hint": "下一小时功率够用，装置来得及达到所需负荷吗？ 附上一项需要接手者核查的记录。", "goal": "逐时检查相邻设定值的差。"},
  {"prompt": "写一段关于“外推误差”的交接说明。", "hint": "模型是否被用于训练数据从未覆盖的温度区间？ 附上一项需要接手者核查的记录。", "goal": "标出训练范围并单列区间外验证结果。"},
  {"prompt": "写一段关于“功能单位”的交接说明。", "hint": "比较包装材料时，按每千克还是每次合格配送核算？ 附上一项需要接手者核查的记录。", "goal": "统一交付功能再统计全程消耗。"},
  {"prompt": "写一段关于“机会约束”的交接说明。", "hint": "调度方案允许多大概率出现无法按时交付？ 附上一项需要接手者核查的记录。", "goal": "用独立历史时段检查实际违约比例。"},
  {"prompt": "写一段关于“排队利用率”的交接说明。", "hint": "为什么设备接近满负荷后等待时间突然增长？ 附上一项需要接手者核查的记录。", "goal": "拆分实际处理时间与排队时间。"},
  {"prompt": "写一段关于“检出限”的交接说明。", "hint": "报表里的零是没有该物质，还是低于检测能力？ 附上一项需要接手者核查的记录。", "goal": "在原始表中保留检出限及标记。"},
  {"prompt": "写一段关于“有效样本量”的交接说明。", "hint": "每秒采一次数据是否等于每秒多一个独立观测？ 附上一项需要接手者核查的记录。", "goal": "按相关时间尺度分块复核结论。"},
  {"prompt": "写一段关于“成本分摊”的交接说明。", "hint": "同一套公用设施的成本怎样分给两个产品？ 附上一项需要接手者核查的记录。", "goal": "公开分摊基准并比较替代口径。"},
  {"prompt": "写一段关于“回归均值”的交接说明。", "hint": "入选改善计划的最差班组，下月变好能否都归功于培训？ 附上一项需要接手者核查的记录。", "goal": "比较相似但未参加培训的班组。"},
  {"prompt": "写一段关于“热惯性”的交接说明。", "hint": "负荷变化后，出口温度多久才能代表新的稳态？ 附上一项需要接手者核查的记录。", "goal": "在时间曲线上标出扰动时刻和稳定区间。"},
  {"prompt": "写一段关于“统计口径”的交接说明。", "hint": "两个月份的停机率用的是日历小时还是计划生产小时？ 附上一项需要接手者核查的记录。", "goal": "把两个期间按同一分母重算。"}
]
