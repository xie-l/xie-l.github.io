  "keywords": [
    {
      "id": 1,
      "term": "贝叶斯优化",
      "category": "统计",
      "definition": "<strong>含义：</strong>基于贝叶斯推断的全局优化方法，利用已有实验结果建立替代模型，智能推荐下一个最值得实验的条件，大幅减少实验次数。",
      "example": "<strong>举例：</strong>传统网格搜索需实验1000次筛选最优催化剂；贝叶斯优化可以在50-100次实验内找到接近最优解——是高通量实验的理想搭档。"
    },
    {
      "id": 2,
      "term": "MXene",
      "category": "材料",
      "definition": "<strong>含义：</strong>二维过渡金属碳化物/氮化物材料，具有金属导电性和亲水表面，是储能和电催化的新型明星材料。",
      "example": "<strong>举例：</strong>Ti₃C₂ MXene导电性接近铜，表面官能团丰富，可作为HER催化剂载体或直接参与催化，近三年相关论文数量呈指数增长。"
    },
    {
      "id": 3,
      "term": "电子结构调控",
      "category": "化学",
      "definition": "<strong>含义：</strong>通过掺杂、界面效应、配位环境等手段，定向改变催化剂金属位点的d带位置或费米能级，优化吸附能，提升活性。",
      "example": "<strong>举例：</strong>在Ni单原子催化剂中引入Fe配位，使Ni的d带中心上移，对*OH的吸附能从过强变为适中，OER过电位从350mV降至240mV。"
    },
    {
      "id": 4,
      "term": "电化学活性面积",
      "category": "化学",
      "definition": "<strong>含义：</strong>ECSA（Electrochemically Active Surface Area），通过电化学方法测定的催化剂有效工作表面积，比BET更接近真实催化活性面积。",
      "example": "<strong>举例：</strong>利用Cu欠电位沉积或Pt吸附脱附峰积分，可准确计算ECSA；ECSA归一化的电流密度称为本征活性，是公平比较催化剂的标准。"
    },
    {
      "id": 5,
      "term": "机器学习势",
      "category": "统计",
      "definition": "<strong>含义：</strong>用机器学习方法拟合DFT数据得到的势能函数，可以以接近DFT精度、远低于DFT计算量的代价进行分子动力学模拟。",
      "example": "<strong>举例：</strong>DeePMD-kit等工具生成的机器学习势，可对含数万原子的催化剂体系做纳秒级MD模拟，是传统DFT的百倍以上的规模。"
    }
  ]
